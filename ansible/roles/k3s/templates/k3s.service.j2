[Unit]
Description=Lightweight Kubernetes ({{ k3s_mode }})
Documentation=https://k3s.io
Wants=network-online.target
After=network-online.target

[Service]
Type={{ k3s_unit_type }}
KillMode=process
Delegate=yes
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
ExecStartPre=-/sbin/modprobe br_netfilter
ExecStartPre=-/sbin/modprobe overlay
ExecStart=/usr/local/bin/k3s {{ k3s_mode }}

[Install]
WantedBy=multi-user.target
