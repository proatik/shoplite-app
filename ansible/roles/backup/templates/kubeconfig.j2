apiVersion: v1
kind: Config
clusters:
  - name: k3s
    cluster:
      server: https://127.0.0.1:6443
      certificate-authority-data: {{ backup_ca.content }}
users:
  - name: postgres-backup
    user:
      token: {{ backup_token.stdout | b64decode }}
contexts:
  - name: backup
    context: { cluster: k3s, user: postgres-backup, namespace: {{ backup_namespace }} }
current-context: backup
