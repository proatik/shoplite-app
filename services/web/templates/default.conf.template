# API_UPSTREAM defaults to http://catalog-api:3000 (set in the Dockerfile).
# The upstream is a variable, so nginx resolves it per request and starts even
# when catalog-api is not up yet. NGINX_LOCAL_RESOLVERS comes from the image
# entrypoint (NGINX_ENTRYPOINT_LOCAL_RESOLVERS) and holds the pod/container DNS.
server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $api_upstream ${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
