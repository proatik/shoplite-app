#!/usr/bin/env bash
# Restores a dump, local or s3://, into a separate database (shoplite_restore by default), so the live
# data is never overwritten. Run it as shoplite-backup, whose kubeconfig may only exec into postgres-0.
set -euo pipefail

if [ $# -lt 1 ]; then
  echo 'usage: shoplite-restore <dump file or s3:// url> [target database]' >&2
  exit 2
fi
dump=$1
target=${2:-shoplite_restore}

if [[ $target =~ [^a-z0-9_] ]]; then
  echo 'the target database name may only use a-z, 0-9 and _' >&2
  exit 2
fi

if [[ $dump == s3://* ]]; then
  local_dump=$(mktemp)
  trap 'rm -f "$local_dump"' EXIT
  aws s3 cp "$dump" "$local_dump" --only-show-errors
  dump=$local_dump
fi

psql() { kubectl -n shoplite exec -i postgres-0 -- psql -U shoplite -d "$1" -v ON_ERROR_STOP=1 -qtA -c "$2"; }

psql shoplite "DROP DATABASE IF EXISTS $target"
psql shoplite "CREATE DATABASE $target"
kubectl -n shoplite exec -i postgres-0 -- pg_restore -U shoplite -d "$target" --no-owner --exit-on-error < "$dump"
echo "restored $dump into $target: $(psql "$target" 'SELECT count(*) FROM information_schema.tables WHERE table_schema = current_schema()') tables"
